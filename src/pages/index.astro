---
import Article from '../components/mobile/Article.astro';
import Header from '../components/mobile/Header.astro';
import '../layout/mobile/Style.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
		<style>
			body {
				background: #101116;
				padding: 0;
				margin: 0;
			}
			* {
				padding: 0;
				margin: 0;
				list-style: none;
				box-sizing: border-box;
				font-size: inherit;
				text-decoration: none;
				font-family: 'DM Sans', sans-serif;
			}
		</style>
	</head>
	<body>
		<Header />
		<Article />
		<div>This is a astro home page</div>
	</body>
</html>
