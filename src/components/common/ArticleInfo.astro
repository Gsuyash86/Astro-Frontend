---
const { title, synopsis, authorDetail, updatedate } = Astro.props;
import { formatDate } from '../Utils';
---

<>
	<div id="artiel-title" class="TitleComponent-HeadingTitle-3oUZ">
		<h1>{title}</h1>
	</div>
	<div id="article-synopsis" class="undefined">
		<div class="Synopsis-container-39Qq undefined">
			<input type="checkbox" id="toggle-read" class="read-more-toggle" />
			<h2 class="Synopsis-synopsis-1RQf undefined Synopsis-clampdata-3-FRT4 synopsis">
				<span class="text">
					{synopsis}
				  </span>
			</h2>
			<label for="toggle-read" class="toggle-label"></label>
		</div>
	</div>
	<div id="article-author">
		<div
			class="tnn__details-user-profile AuthorDetailWidget-tnn__details-user-profile-3MOv"
		>
			<div>
				<div>
					<img
						src=`https://images.timesdrive.in/authorthumb/${authorDetail?.id}.cms?width=70&height=70&hid=1001`
						alt="author-479251660"
					/>
				</div>
			</div>
			<div class="AuthorDetailWidget-author_row-3LQF undefined">
				<a
					href="https://localhost:3000/author/saptak-bardhan-479251660"
					title=""><strong><span>{authorDetail?.name}</span></strong></a
				>
				<p>
					{formatDate(new Date(+updatedate))}
				</p>
			</div>
		</div>
	</div>
</>
<style>
	.read-more-container {
  position: relative;
  max-width: 600px;
}

.read-more-toggle {
  display: none;
}

.synopsis {
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 3; /* show only 3 lines */
  -webkit-box-orient: vertical;
  transition: all 0.3s ease-in-out;
}

.read-more-toggle:checked ~ .synopsis {
  -webkit-line-clamp: unset;
  overflow: visible;
}

.toggle-label::after {
  content: "Read More";
  color: #FFF;
  cursor: pointer;
  display: inline-block;
  margin-top: 5px;
  
}
label.toggle-label {
    position: absolute;
    padding-left: 21px !important;
    cursor: pointer;
    bottom: 0;
    right: 18px;
    background: #101116;
}
.read-more-toggle:checked ~ .toggle-label::after {
  content: "Read Less";
}
</style>