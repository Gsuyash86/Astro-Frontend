---
const { data, title } = Astro.props;
import {  getNewImageUrl } from '../../components/Utils';
---

<section class="ListCard-list_cardsection-3o2k">
	<span
		class="Heading-heading-24YR undefined undefined undefined undefined undefined"
		><a href="https://localhost:3000/" title="" id="td_heading_Most Popular"
			>{title}</a
		>
	</span>
	{
		data?.map((item) => (
			<a href={`${item?.seopath}-article-${item?.msid}`} title="" id="relatedNewsGA_0">
				<div class="ListCard-tnn__h-list-2fe7 false">
					<figure>
						<figcaption>
							<p>{item?.title}</p>
						</figcaption>
						<div>
							<img
              src={getNewImageUrl({
                msid: item?.msid || null,
                imgSize: item?.imageSize || item?.thumbsize || '',
                imgWidth: 300,
                imgHeight: 168,
                updatedAt: item?.updatedAt || ''
              })}
              alt={item?.title || ''}
              width="300"
              height="168"
              loading="lazy"
            />
						</div>
					</figure>
				</div>
			</a>
		))
	}
</section>
