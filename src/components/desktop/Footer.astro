---
import s from './Footer.scss';
import { SOCIAL_LINKS_ZE } from '../../constants/index';
---

<>
	<footer class={s.footer}>
		<div class={s.container}>
			<div class={s['mb-15']}>
				<div class={`${s.d_flex} ${s.justify_space_between}`}>
					<div class={`${s.footer__social_icons} ${s.d_flex}`}>
						<div class={`${s.footer__folowus} ${s.d_flex}`}>
							<p>Follow us :</p>
						</div>
						{
							Object.keys(SOCIAL_LINKS_ZE).map((item) => {
								return (
									<Link
										key={`${SOCIAL_LINKS_ZE[item]?.link}_footer_desktop`}
										to={SOCIAL_LINKS_ZE[item]?.link || ''}
									>
										<button class={s.icon_button} type="button">
											<img
												loading="lazy"
												src={`/assets/icons/svg/${SOCIAL_LINKS_ZE[item].id}.svg`}
												alt={`${SOCIAL_LINKS_ZE[item].id}`}
											/>
											{/* {SOCIAL_LINKS_ZE[item]?.darkIcon()} */}
										</button>
									</Link>
								);
							})
						}
					</div>
					<div class={s['open-in-app']}>
						<div class={s['open-in-app-button']}>
							<a href="/info/times-network-app">Download App</a>
							<span>
								<a
									href="https://apps.apple.com/in/app/times-network/id979120111"
									target="_blank"
								>
									<img
										loading="lazy"
										src="/assets/images/OpenInApp/app-store-w.png"
										alt="open in App"
									/>
								</a>
							</span>
							<span>
								<a
									href="https://play.google.com/store/apps/details?id=com.timesnowmobile.TimesNow"
									target="_blank"
								>
									<img
										loading="lazy"
										src="/assets/images/OpenInApp/play-store.png"
										alt="play store"
									/>
								</a>
							</span>
						</div>
					</div>
				</div>
			</div>

			<div class={`${s.footer__quick_link} ${s['border-top-bottom']}`}>
				{
					data?.data?.footerlinks?.map((footerlink) => (
						<div class={s['divider-footer']}>
							{this.state.isFooterLinkCollapse && (
								<>
									<div class={s['title-wrapper']}>
										<strong class={`${s.footer__title} ${s['mb-8']}`}>
											{footerlink?.title}
										</strong>
									</div>
									{footerlink &&
									footerlink.children &&
									footerlink.children.length > 0
										? footerlink.children.map((item, id) => {
												if (item && !item.seopath) return '';
												return (
													<div class={`${s['d_flex']} ${s['align-basline']}`}>
														<span class={s['rightarrow']} />
														<Link
															key={item?.title}
															to={getTargetURL({
																...(item?.overridelink && {
																	overrideString: item?.overridelink || '',
																}),
																normalString: `${item?.seopath}-${getSlug(
																	item?.cmstype
																)}-${item?.msid}`,
																storyType: item?.cmstype,
																msid: item?.msid,
																seoPath: item?.seopath,
															})}
															class={`${s.icon_button}`}
															noFollowNotRequired={true}
														>
															<span>{removeHtmlTags(item.title)}</span>
														</Link>
													</div>
												);
										  })
										: null}
								</>
							)}
						</div>
					))
				}
			</div>

			<div class={`${s.footer__quick_link}`}>
				<div class={s['title-wrapper']}>
					<strong class={`${s.footer__title} ${s['mb-8']}`}>
						{
							data && data.data && data.data.title
								? decodeHtml(data.data.title)
								: null
						}
					</strong>
				</div>

				<div class={s['flex-warp']}>
					{
						data &&
						data.data &&
						data.data.children &&
						data.data.children.length > 0
							? data.data.children.map((items, id) => {
									if (items && !items.seopath) return '';
									return (
										<div class={`${s['d_flex']} ${s['flex']}`}>
											<span class={s['rightarrow']} />
											<Link
												key={items?.title}
												to={
													(STATIC_PAGES_MSID?.internalLinks?.includes(
														items.msid
													)
														? lang.baseUrl
														: langConfig.english.baseUrl) +
													(items.seopath
														? (isEnglish ? '/info' : '') +
														  (items.seopath ? items.seopath : '')
														: '')
												}
												target={!isEnglish ? '_blank' : ''}
												class={`${s.icon_button}`}
											>
												<span
													style={{
														marginLeft: '10px',
													}}
												>
													{decodeHtml(items.title)}
												</span>
											</Link>
										</div>
									);
							  })
							: null
					}
				</div>
			</div>
		</div>
		<div class={`${s['copyright-section']}`}>
			<p>{COPYRIGHT}</p>
		</div>
	</footer>
</>
