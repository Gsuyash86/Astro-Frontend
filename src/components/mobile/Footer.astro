---
const response = await fetch(
	'https://stgapi.timesdrive.in/request/footer?msid=ALL&channel=1001'
);
const data = await response.json();
const mainData = data?.response?.[0];
const footerLinks = mainData?.data?.footerlinks;
---

<footer class="Footer-Footer-rDpt">
	<section class="Subscribe-SubscribeNewsletter-2xRu">
		<div
			class="ContainerBox-container-1W4X undefined"
			style="margin-bottom: 0px"
		>
			<div class="Subscribe-SubscribeRow-1VLE">
				<div>
					<h3>
						Subscribe to our newsletter
						<p>
							Get the latest cars and bike updates to stay ahead of the rest!
						</p>
					</h3>
					<div class="Subscribe-inputRow-2qdL">
						<input
							type="email"
							class="undefined"
							placeholder="Enter your email address"
						/><button class="undefined" id="td_subscribe_bottom">
							Submit
						</button>
					</div>
					<div class="Subscribe-error-1YLV"><span></span></div>
				</div>
			</div>
		</div>
	</section>
	<div class="Footer-container-1bNN">
		<div class="Footer-row--Q3o">
			<div class="Footer-footerBox-2QaJ Footer-logo-1H67">
				<a href="/" title="" id="footer-logo-mobile"
					><img
						src="/assets/icons/svg/TimesDrive.svg"
						alt="Times Drive"
						width="130"
						height="26"
					/></a
				>
				<ul class="Footer-FollowUs-1YJ1">
					<li>Follow Us:</li>
					<li>
						<a href="https://www.facebook.com/TNtimesdrive/" title=""
							><img
								src="/assets/icons/svg/fb-dark-icon.svg"
								alt="fb-dark-icon"
							/></a
						>
					</li>
					<li>
						<a href="https://twitter.com/TNTimesDrive" title=""
							><img
								src="/assets/icons/svg/twitter-dark-icon-new.svg"
								alt="twitter-dark-icon-new"
							/></a
						>
					</li>
					<li>
						<a
							href="https://www.instagram.com/tntimesdrive?igsh=Z3djdjhyYnVpam12"
							title=""
							><img
								src="/assets/icons/svg/insta-dark-icon.svg"
								alt="insta-dark-icon"
							/></a
						>
					</li>
				</ul>
				<div class="Footer-Right-1tLN">
					<span>Download App</span><a
						href="https://play.google.com/store/search?q=times+drive&c=apps&hl=en"
						><img
							src="https://static.tnn.in/photo/113288092.cms"
							alt="googlep play"
						/></a
					>
				</div>
			</div>
			{
				footerLinks?.map((item) => (
					<div class="Footer-footerBox-2QaJ">
						<div>
							<p class="Footer-FooterTitle-2dvC">{item.title}</p>
							<ul class="Footer-footerNav-3XMd">
								{item?.children?.map((child) => (
									<li>
										<a
											href={
												child?.overridelink || child?.storyUrl || child?.seopath
											}
											rel="noopener"
											class="undefined"
											title=""
										>
											{child.title}
										</a>
									</li>
								))}
							</ul>
						</div>
					</div>
				))
			}
		</div>
		<div class="Footer-subFooter-2vAD">
			<span class="Footer-FooterTitle-2dvC">Company</span>
			<ul>
				{
					mainData?.data?.children?.map((item) => (
						<li>
							<a
								href={`/${item?.seopath}`}
								rel="noopener"
								class="undefined"
								title=""
							>
								{item.title}
							</a>
						</li>
					))
				}
			</ul>
		</div>
		<span class="Footer-copyright-1F3b"
			>© 2024 Bennett, Coleman &amp; Company Limited</span
		>
	</div>
</footer>
