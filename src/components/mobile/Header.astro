---
import HeaderLocation from '../common/HeaderLocation/HeaderLocation.astro';
import HeaderSearch from '../common/HeaderSearch/HeaderSearch.astro';
import './Header.css';
const response = await fetch(
	'https://api.timesdrive.in/api/getnavigation?msid=ALL&channel=1001'
);

const data = await response.json();
const mainData = data?.response;
const location = Astro?.cookies?.get('userLocation')?.value?.toLowerCase().replace(/\s+/g, '-') || 'hyderabad';
const currentSelectedVehicle = Astro?.cookies?.get('brandModel');
---

<header id="Header-header-VKX9" class="mobile-header">
	<div class="Header-container-2qVa">
		<div class="Header-header-VKX9">
			<div
				class="Header-navBar-luli"
				on="tap:ampHamburger.toggle"
				role="button"
				tabindex="0"
				id="open_burger_icon"
				aria-label="humburgerMenuButton"
			>
				<span></span><span></span><span></span>
			</div>
			<div class="Header-logo-nBC1">
				<a href="/" title="" id="header-logo-mobile"
					><img
						src="/assets/icons/svg/TimesDrive.svg"
						alt="Times Drive"
						width="130"
						height="26"
					/></a
				>
			</div>
			<div class="Header-headerRight-3ItC" id="mobile_drawer">
				<div class="Header-logo-nBC1">
					<a href="/" title=""
						><img
							src="/assets/icons/svg/TimesDrive.svg"
							alt="Times Drive"
							width="130"
							height="26"
						/></a
					>
				</div>
				<nav id="amp_drawer_new">
					<ul>
						{
							mainData?.map((data) => (
								<li>
									<a href={`/${data.seopath}`}>{data.title}</a>
									<i style="color: white;">click</i>
									<ul class="">
										{data?.child?.map(child=>( 
											<li class="">
													<a
														href={`/${child.seopath}`}
														title={child?.title}
														id="td_header_submenu_nav_latest-news"
														>{child.title}</a>
													
												</li>
										))}
												 
											</ul>
								</li>
							))
						}
					</ul>
					{
						currentSelectedVehicle && (
							<div>
								<div class="Header-ShowInterest-2UxI" id="showInterest">
									<i
										><img
											width="auto"
											height="auto"
											src="https://images.timesdrive.in/photo/msid-125081630,thumbsize-335230,width-200,height-200,false/125081630.jpg"
											alt="Royal Enfield Bullet 350"
										/></i>
									<p>Looks like you are searching {currentSelectedVehicle?.value}</p>
								</div>
								<a
									href={`${currentSelectedVehicle?.value}`}
									title="">Show Interest
								</a>
							</div>
						)
					}
					<button
						class="Navigation-navClose-I9r6"
						on="tap:ampHamburger.toggle"
						role="button"
						id="close-icon"
					>
						X
					</button>
				</nav>
			</div>
			<div class="Header-HeaderRight-2fwU">
				<div class="Header-Location-s2N8" id="headerLocation">
					<i
						><img
							src="/assets/icons/svg/Locationsign.svg"
							alt="LocationIcon"
						/></i
					>
					<p>{location || 'Hyderabad'}</p>
				</div>

				<i class="Header-search-icon-3Ys0"
					><img src="/assets/icons/svg/search.svg" alt="search-icon" /></i
				>
			</div>
			<div id="headerLocationdynamic" style="display: none;">
				<HeaderLocation />
			</div>
			<div class="headerSearch" style="display: none;">
				<HeaderSearch />
		</div>
		</div>
	</div>
	<script>
		document
			.querySelector('#open_burger_icon')
			?.addEventListener('click', () => {
				document.querySelector('#mobile_drawer').style.left = '0px';
			});

		document.querySelector('#close-icon')?.addEventListener('click', () => {
			document.querySelector('#mobile_drawer').style.removeProperty('left');
		});

		document.querySelector('.Header-search-icon-3Ys0')?.addEventListener('click', () => {
			const headerSearch = document.querySelector('.headerSearch');
			if (headerSearch) {
				headerSearch.style.display = headerSearch.style.display === 'none' ? 'block' : 'none';
			}
		});

		document.querySelector('#headerLocation')?.addEventListener('click', () => {
			const headerLocation = document.querySelector('#headerLocationdynamic');
			if (headerLocation) {
				headerLocation.style.display = headerLocation.style.display === 'none' ? 'block' : 'none';
			}
		});
	</script>
</header>
